    const-string/jumbo v1, "vec3 fullToSingleGainConvert(vec3 color) {\n    // Step 1: \u8bfb\u53d6\u4e09\u901a\u9053\u589e\u76ca\u56fe\u503c G \u2208 [0, 1]\uff08\u4ece\u4f20\u5165\u7684 color \u53c2\u6570\u83b7\u53d6\uff09\n    vec3 G = color.rgb;\n    \n    // Step 2: \u89e3\u7801 - \u53cd gamma \u5f97\u5230\u5f52\u4e00\u5316\u589e\u76ca\n    vec3 G_linear = pow(G, vec3(1.0) / uGainmapGamma);\n    \n    // Step 3: \u53cd\u5f52\u4e00\u5316 - \u5f97\u5230 log(gain)\uff0c\u8fd9\u91cc uLogRatioMin/Max \u5df2\u7ecf\u662f\u81ea\u7136\u5bf9\u6570\n    vec3 L = mix(uLogRatioMin, uLogRatioMax, G_linear);\n    \n    // Step 4: \u8f6c\u6362\u4e3a\u7ebf\u6027\u57df\u589e\u76ca\n    vec3 gainLinear = exp(L);\n    \n    // Step 5: \u5728\u7ebf\u6027\u57df\u7528\u4eae\u5ea6\u7cfb\u6570\u52a0\u6743\u5e73\u5747 (uLuminanceCoef \u6839\u636e\u8272\u5f69\u7a7a\u95f4\u4f20\u5165)\n    float gainSingle = dot(gainLinear, uLuminanceCoef);\n    \n    // Step 6: \u91cd\u65b0\u7f16\u7801\u4e3a\u5355\u901a\u9053\n    // \u8f6c\u56de\u5bf9\u6570\u57df (\u907f\u514d log(0) \u4ea7\u751f -inf)\n    float L_single = log(max(gainSingle, 0.0001));\n    \n    // \u4f7f\u7528\u8f93\u51fa\u5143\u6570\u636e\u5f52\u4e00\u5316 (uOutLogRatioMin/Max \u662f\u8f93\u51fa\u7684\u5bf9\u6570\u8303\u56f4)\n    float G_single = (L_single - uOutLogRatioMin) / (uOutLogRatioMax - uOutLogRatioMin);\n    G_single = clamp(G_single, 0.0, 1.0);\n    \n    // \u5e94\u7528\u8f93\u51fa gamma (\u4f7f\u7528\u4eae\u5ea6\u52a0\u6743\u5e73\u5747\u540e\u7684 gamma)\n    float outputVal = pow(G_single, uOutGamma);\n    \n    return vec3(outputVal);\n}"

