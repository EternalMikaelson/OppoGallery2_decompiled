            <float name="discrete_array"></float>

            <!--参数最小值，选配，当参数有最大最小值时配置。需要设置时，此处标签要同参数类型保持一致-->
            <int name="min">0</int>

            <!--参数最大值，选配，当参数有最大最小值时配置。需要设置时，此处标签要同参数类型保持一致-->
            <int name="max">100</int>

            <!--参数默认值，选配，当参数有最大最小值时配置。需要设置时，此处标签要同参数类型保持一致-->
            <int name="default">50</int>
