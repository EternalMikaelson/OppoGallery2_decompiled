    <long name="version">2024050901</long>

    <!--插件编辑能力入口类，其实现export中定义的功能标准-->
    <string name="identifier">com.oplus.tbluniformeditor.plugins.blur.function.BlurAlgoImpl</string>

    <!--插件编辑能力入口类，其实现export中定义的功能标准-->
    <string name="description">blur_plugin</string>

