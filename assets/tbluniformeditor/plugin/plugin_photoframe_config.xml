<?xml version="1.0" encoding="UTF-8"?>
<plugin-meta>
    <!--插件版本，由插件开发者定义，建议格式：年/月/日/两位序号，如：2023112101-->
    <long name="version">2024051001</long>

    <!--插件类型，指当前插件元信息是静态配置还是动态获取-->
    <!--静态配置：插件的编辑能力，通过parameter标签配置-->
    <!--动态配置：插件的编辑能力，通过插件接口动态获取-->
    <!--必选-->
    <boolean name="dynamic">false</boolean>

    <!--插件编辑能力入口类，其实现export中定义的功能标准-->
    <string name="identifier">com.oplus.tbluniformeditor.plugins.photoframe.function.PhotoframeAlgoImpl</string>

    <!--插件编辑能力查询静态接口名，如：config -->
    <!--静态配置的插件，参数配置空字符串即可或者不配置-->
    <string name="dynamic_identifier"></string>

    <!--插件是否支持HDR编辑-->
    <boolean name="hdr_support">false</boolean>

    <!--插件支持的HDR编码方案-->
    <!--目前hdr的编码方案有：local_hdr,ultra_hdr,hdr_hlg,hdr_pq,hdr_none.插件根据自身支持情况选填-->
    <!--如果插件不支持hdr,即 hdr_support配置为false, 此处配置为hdr_none-->
    <string name="hdr_scheme">hdr_none</string>

    <!--插件支持的HDR编辑方案-->
    <!--目前hdr的实施方案有：independent, combine, none.插件根据自身支持情况选填-->
    <!--如果插件不支持hdr,即 hdr_support配置为false, 此处配置为none-->
    <string name="hdr_edit_scheme">none</string>

    <!--插件编辑能力入口类，其实现export中定义的功能标准-->
    <string name="description">photoframe plugin meta description config</string>

    <!--插件名称-->
    <string name="name">photoframe_plugin</string>

    <!--插件的copyright描述-->
    <string name="copyright">OPLUS Mobile Comm Corp Ltd</string>

    <!--插件的作者描述-->
    <string name="creator">yangliu@oppo.com</string>

    <!--插件参数信息，需要时配置, 配置信息由插件池解析完下发给具体插件，以便插件执行时查找， 有多个参数时，配置多个parameter-->
    <parameters>
        <parameter>
            <!--参数名-->
            <string name="identifier">key_photoframe_plugin</string>

            <!--参数类型：int, double, string, boolean-->
            <string name="type">int</string>

            <!--参数描述-->
            <string name="description">get photo frame background</string>

            <!--参数分布是否是离散-->
            <boolean name="discrete">false</boolean>

            <!--离散数据配置：参数范围，如比例范围等-->
            <!--多个数据直接使用逗号隔开, 参数类型要和标签保持一致 -->
            <string name="discrete_array">""</string>

            <!--连续数据数据配置：参数最小值，选配，当参数有最大最小值时配置。
            需要设置时，此处标签要同参数类型保持一致 -->
            <int name="min">0</int>

            <!--连续数据数据配置：参数最大值，选配，当参数有最大最小值时配置。
            需要设置时，此处标签要同参数类型保持一致 -->
            <int name="max">0</int>

            <!--连续数据数据配置：参数默认值，选配，当参数有最大最小值时配置。
            需要设置时，此处标签要同参数类型保持一致 -->
            <int name="default">0</int>
        </parameter>
    </parameters>
</plugin-meta>