<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_checked="true" android:id="@id/radio_on" android:drawable="@drawable/cloudkit_btn_check_on_normal" />
    <item android:state_enabled="true" android:state_checked="false" android:id="@id/radio_off" android:drawable="@drawable/cloudkit_btn_check_off_normal" />
    <item android:state_enabled="false" android:state_checked="true" android:drawable="@drawable/cloudkit_btn_check_on_disabled" />
    <item android:state_enabled="false" android:state_checked="false" android:drawable="@drawable/cloudkit_btn_check_off_disabled" />
    <transition android:drawable="@drawable/cloudkit_checkbox_selected_to_unselected" android:toId="@id/radio_off" android:fromId="@id/radio_on" />
    <transition android:drawable="@drawable/cloudkit_checkbox_unselected_to_selected" android:toId="@id/radio_on" android:fromId="@id/radio_off" />
</animated-selector>
