<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:height="@dimen/caption_item_resource_outer_size" android:width="@dimen/caption_item_resource_outer_size" />
                    <solid android:color="@color/common_transparent" />
                    <corners android:radius="@dimen/caption_item_item_outer_radius" />
                    <stroke android:width="@dimen/caption_item_border_width" android:color="?couiColorContainerTheme" />
                </shape>
            </item>
            <item android:gravity="center" android:height="@dimen/caption_item_resource_inner_size" android:width="@dimen/caption_item_resource_inner_size">
                <shape android:shape="rectangle">
                    <solid android:color="@color/caption_style_item_background_color" />
                    <corners android:radius="@dimen/caption_item_item_inner_radius" />
                    <stroke android:width="0.0dp" android:color="@color/caption_style_item_background_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:height="@dimen/caption_item_resource_outer_size" android:width="@dimen/caption_item_resource_outer_size" />
                    <solid android:color="@color/common_transparent" />
                </shape>
            </item>
            <item android:gravity="center" android:height="@dimen/caption_item_resource_inner_size" android:width="@dimen/caption_item_resource_inner_size">
                <shape android:shape="rectangle">
                    <solid android:color="@color/caption_style_item_background_color" />
                    <corners android:radius="@dimen/caption_item_item_inner_radius" />
                    <stroke android:width="0.0dp" android:color="@color/caption_style_item_background_color" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
