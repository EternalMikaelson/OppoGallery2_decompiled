<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/picture3d_sticker_stroke_style_selected_border_width" android:color="@color/picture3d_sticker_stroke_color_not_hassel" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/picture3d_sticker_stroke_style_selected_border_radius" />
        </shape>
    </item>
    <item android:left="@dimen/picture3d_sticker_stroke_style_selected_border_inset" android:top="@dimen/picture3d_sticker_stroke_style_selected_border_inset" android:right="@dimen/picture3d_sticker_stroke_style_selected_border_inset" android:bottom="@dimen/picture3d_sticker_stroke_style_selected_border_inset">
        <shape android:shape="rectangle">
            <solid android:color="@color/picture3d_sticker_stroke_style_selected_background" />
            <corners android:radius="@dimen/picture3d_sticker_stroke_style_item_radius" />
        </shape>
    </item>
</layer-list>
