<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/common_caption_seekbar_progress_radius" />
            <solid android:color="@color/common_caption_seekbar_progress_background_color" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/common_caption_seekbar_progress_radius" />
                <solid android:color="?couiColorContainerTheme" />
            </shape>
        </clip>
    </item>
</layer-list>
