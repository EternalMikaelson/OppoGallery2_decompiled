<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cloudkit_color_package_background_selected_50" />
            <corners android:radius="@dimen/cloudkit_round_corner_s" />
            <stroke android:width="2.0dp" android:color="@color/cloudkit_color_package_background_selected_border_50" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cloudkit_color_package_background" />
            <corners android:radius="@dimen/cloudkit_round_corner_s" />
        </shape>
    </item>
</selector>
