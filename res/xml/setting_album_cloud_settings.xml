    <com.coui.appcompat.preference.COUIPreferenceCategory>
        <com.coui.appcompat.preference.COUIRecommendedPreference android:key="perf_key_cloud_setting_faq" app:isPreferenceVisible="false" />
        <com.coui.appcompat.preference.COUIBottomPreference />
