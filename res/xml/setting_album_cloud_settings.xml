        <com.coui.appcompat.preference.COUIJumpPreference android:title="@string/cloud_setting_data_detail" android:key="pref_key_cloud_setting_data_detail" app:couiShowDivider="true" />
        <com.coui.appcompat.preference.COUIJumpPreference android:title="@string/cloud_service_enabled_devices" android:key="pref_key_cloud_setting_sync_enable_devices" app:couiShowDivider="false" />
