        <com.coui.appcompat.preference.COUISwitchLoadingPreference android:title="@string/setting_category_cloud_sync_title" android:key="pref_key_cloud_setting_auto_sync" android:defaultValue="false" app:couiShowDivider="false" />
        <com.oplus.gallery.framework.abilities.ocloudsync.ui.LoadingJumpPreference android:title="@string/cloud_sync_setting_service_mode" android:key="pref_key_cloud_setting_sync_service_mode" app:couiShowDivider="true" />
