<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="0" android:valueFrom="@dimen/menu_button_common_selected_alpha" android:valueTo="@dimen/menu_button_common_pressed_alpha" android:propertyName="alpha" />
        </set>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <set>
            <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="100" android:valueFrom="@dimen/menu_button_common_pressed_alpha" android:valueTo="@dimen/menu_button_common_selected_alpha" android:propertyName="alpha" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="0" android:valueFrom="@dimen/menu_button_common_pressed_alpha" android:valueTo="@dimen/menu_button_common_selected_alpha" android:propertyName="alpha" />
        </set>
    </item>
</selector>
