<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="15.0dp" android:layout_marginEnd="15.0dp">
        <TextView android:textSize="24.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="捏合动效：" />
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="放大时加速度的最大值" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_zoom_out_acceleration_max" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="1.5" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="缩小时加速度的最大值" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_zoom_in_acceleration_max" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="1.5" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <TextView android:textSize="24.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling：" />
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的速度修正系数" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_velocity_factor" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="1.0" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的最小速度" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_velocity_min" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="500" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的最大速度" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_velocity_max" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="5000" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的阻尼系数" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_friction" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="0.015" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的最短时间" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_duration_min" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="500" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fling的最长时间" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_fling_duration_max" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="500" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插值器" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_interpolator_y2" android:layout_width="48.0dp" android:layout_height="wrap_content" android:hint="y2" android:layout_alignParentEnd="true" />
            <EditText android:id="@id/animation_interpolator_x2" android:layout_width="48.0dp" android:layout_height="wrap_content" android:hint="x2" android:layout_marginEnd="5.0dp" android:layout_toStartOf="@id/animation_interpolator_y2" />
            <EditText android:id="@id/animation_interpolator_y1" android:layout_width="48.0dp" android:layout_height="wrap_content" android:hint="y1" android:layout_marginEnd="5.0dp" android:layout_toStartOf="@id/animation_interpolator_x2" />
            <EditText android:id="@id/animation_interpolator_x1" android:layout_width="48.0dp" android:layout_height="wrap_content" android:hint="x1" android:layout_marginEnd="5.0dp" android:layout_toStartOf="@id/animation_interpolator_y1" />
        </RelativeLayout>
        <TextView android:textSize="24.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="极限效果：" />
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="极限能放大到原始的倍数" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_over_max_scale_factor" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="1.2" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="极限能缩小到原始的倍数" android:layout_alignParentStart="true" />
            <EditText android:id="@id/animation_over_min_scale_factor" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="0.97" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <TextView android:textSize="24.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="个性化筛选：值>0有效" />
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="年" android:layout_alignParentStart="true" />
            <EditText android:id="@id/personal_filter_year" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="-1" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="30.0dp">
            <TextView android:textSize="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="类型1图2视频3收藏" android:layout_alignParentStart="true" />
            <EditText android:id="@id/personal_filter_type" android:layout_width="80.0dp" android:layout_height="wrap_content" android:hint="-1" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
